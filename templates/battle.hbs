<form autocomplete="off">

    <fieldset class="row">
        <legend>At rest</legend>
        <div class="form-group">
            <label>Name</label>
            <input class="name" type="text" name="name" data-type="atRest" value="{{atRest.name}}">
        </div>
        <div class="form-group">
            <label>Image path</label>
            <div class="form-fields">
                <file-picker class="image" name="atRestImage" type="imagevideo" value="{{atRest.path}}" data-type="atRest"></file-picker>
                <button type="button" class="flip-delete" data-type="atRest"><i class="fas fa-trash"></i></button>
            </div>
        </div>
        <div class="form-group">
            <label>Portrait path</label>
            <div class="form-fields">
                <file-picker class="portrait" name="atRestImageP" type="imagevideo" value="{{atRest.portrait}}" data-type="atRest"></file-picker>
                <button type="button" class="flip-delete" data-type="atRest"><i class="fas fa-trash"></i></button>
            </div>
        </div>
        <div class="form-group scale">
            <label>Scale</label>
            <div class="form-fields">
                <input type="range" name="scale" value={{atRest.scale}} min="0.2" max="3.0" step="0.1" class="scale-value" data-type="atRest">
                <span class="range-value">{{atRest.scale}}</span>
            </div>
        </div>
    </fieldset>

    <fieldset class="row">
        <legend>Combat</legend>
        <div class="form-group">
            <label>Name</label>
            <input class="name" type="text" name="name" data-type="inCombat" value="{{inCombat.name}}">
        </div>
        <div class="form-group">
            <label>Image path</label>
            <div class="form-fields">
                <file-picker class="image" name="inCombatImage" type="imagevideo" value="{{inCombat.path}}" data-type="inCombat"></file-picker>
                <button type="button" class="flip-delete" data-type="inCombat"><i class="fas fa-trash"></i></button>
            </div>
        </div>
        <div class="form-group">
            <label>Portrait path</label>
            <div class="form-fields">
                <file-picker class="portrait" name="inCombatImageP" type="imagevideo" value="{{inCombat.portrait}}" data-type="inCombat"></file-picker>
                <button type="button" class="flip-delete" data-type="inCombat"><i class="fas fa-trash"></i></button>
            </div>
        </div>
        <div class="form-group scale">
            <label>Scale</label>
            <div class="form-fields">
                <input type="range" name="scale" value={{inCombat.scale}} min="0.2" max="3.0" step="0.1" class="scale-value" data-type="inCombat">
                <span class="range-value">{{inCombat.scale}}</span>
            </div>
        </div>
    </fieldset>

</form>