<div class="scrollable">

    {{#each values as |value|}}
        <fieldset class="row">
            <div class="form-group">
                <label>Name</label>
                <div class="form-fields">
                    <input class="name" type="text" name="name" data-type="String" value="{{value.name}}" data-idx={{value.idx}}>
                    <button type="button" class="flip-delete" data-idx={{value.idx}}><i class="fas fa-trash"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label>Image path</label>
                <div class="form-fields">
                    <file-picker class="image" name={{value.target}} type="imagevideo" value="{{value.path}}"
                                 data-idx={{value.idx}}></file-picker>
                </div>
            </div>
            <div class="form-group">
                <label>Portrait path</label>
                <div class="form-fields">
                    <file-picker class="portrait" name={{value.targetP}} type="imagevideo" value="{{value.portrait}}"
                                 data-idx={{value.idx}}></file-picker>
                </div>
            </div>
            <div class="form-group scale">
                <label>Scale</label>
                <div class="form-fields">
                    <input type="range" name="scale" value={{value.scale}} min="0.2" max="3.0" step="0.1" class="scale-value"
                           data-idx={{value.idx}}>
                    <span class="range-value">{{value.scale}}</span>
                </div>
            </div>
        </fieldset>
    {{/each}}


    <footer class="sheet-footer flexrow">
        <button type="button" class="flip-save"><i class="fas fa-add"></i>Add token image</button>
    </footer>
</div>
